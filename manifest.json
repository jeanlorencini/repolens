{
  "manifest_version": 3,
  "name": "GitHub em Linguagem Simples",
  "description": "Mostra uma explicação acessível no lugar do README, com botão para recuperar o original.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": {"default_title": "Configurar GitHub em Linguagem Simples"}
}
